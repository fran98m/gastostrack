<?xml version="1.0" encoding="utf-8"?>
<!-- Archivo is a variable font (wght axis); each weight we use gets its own
     font-family resource pinned to one instance via fontVariationSettings. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/archivo_variable"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400" />
</font-family>
